# SmartupCMS: one installation, one organization, many users.
# Copy this file to .env. Keep .env and all referenced secret files at mode 0600.

PROJECT_NAME=smartupcms
IMAGE_REGISTRY=ghcr.io/smartupcms
APP_VERSION=

# Optional full immutable references. Smartup-managed installations MUST set
# all five to the values from the signed release metadata. Client-owned installs
# may use the APP_VERSION fallback after independently verifying the tag.
SERVER_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=
POSTGRES_IMAGE=
TYPESENSE_IMAGE=

ORGANIZATION_CODE=default
ORGANIZATION_NAME=
RESOURCE_PROFILE=S

# Database credentials (I-02 Least Privilege role separation)
DB_NAME=smartupcms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_FILE=./.secrets/database-password
MIGRATE_DB_USER=smartupcms_migrator
MIGRATE_DB_PASSWORD=
MIGRATE_DB_PASSWORD_FILE=./.secrets/database-password
DB_USER=smartupcms
DB_PASSWORD=
DB_PASSWORD_FILE=./.secrets/database-password
BACKUP_DB_USER=smartupcms_backup
BACKUP_DB_PASSWORD_FILE=./.secrets/backup-database-password

ADMIN_LOGIN=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

TYPESENSE_API_KEY=

# local_disk for an installation-owned volume; s3 for R2/S3-compatible storage.
DWH_PROVIDER_STORAGE=local_disk
DWH_S3_ENDPOINT=
DWH_S3_REGION=auto
DWH_S3_ACCESS_KEY=
DWH_S3_SECRET_KEY=
DWH_S3_BUCKET=
DWH_S3_PATH_STYLE=true

# Production uploads are fail-closed and the bundled ClamAV service is always
# enabled. Override only with another immutable, reviewed official image.
CLAMAV_IMAGE=clamav/clamav-debian:1.5.3@sha256:741e6c447241220e0792a901befcaec1d55a755c5097fc9cd88d7fd8be251a5c
DWH_FILE_SCANNER_CLAMAV_HOST=clamav
DWH_FILE_SCANNER_CLAMAV_PORT=3310
DWH_FILE_SCANNER_CLAMAV_CONNECT_TIMEOUT=3s
DWH_FILE_SCANNER_CLAMAV_READ_TIMEOUT=60s

# Public localization dictionaries have a separate per-IP bucket so users
# behind one corporate NAT do not exhaust the stricter anonymous/login bucket.
DWH_RATE_LIMIT_PUBLIC_READ_PER_MINUTE=600

# Outbound webhooks are disabled unless the operator supplies an exact host allow-list.
DWH_WEBHOOKS_ENABLED=false
DWH_WEBHOOKS_ALLOWED_HOSTS=
# Client-owned private destinations require an explicit opt-in. Keep false on managed installs.
DWH_WEBHOOKS_ALLOW_PRIVATE_ADDRESSES=false
DWH_WEBHOOKS_CONNECT_TIMEOUT=3s
DWH_WEBHOOKS_READ_TIMEOUT=10s

# The web container is the only published origin. Terminate TLS at Cloudflare
# or at the host reverse proxy, then forward to this loopback listener.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Backups always require age encryption, including local-only mode.
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
# Approved maximum recovery-point age for the System page; 0s is explicitly unconfigured.
DWH_BACKUP_MAX_AGE=0s
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_MODE=local

# Set BACKUP_STORAGE_MODE=s3 to enable an off-host R2/S3 copy.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_ACCESS_KEY_ID_FILE=./.secrets/backup-s3-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY_FILE=./.secrets/backup-s3-secret-access-key
